rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 0. Global Safety Net ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validators ---
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'username']) &&
        data.id is string && data.id.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        data.username is string && data.username.size() <= 100 &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidWorkout(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'startedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.startedAt is string && data.startedAt.size() <= 64 &&
        (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 64)) &&
        (!('durationSeconds' in data) || data.durationSeconds is number) &&
        (!('totalVolumeKg' in data) || data.totalVolumeKg is number) &&
        (!('totalSets' in data) || data.totalSets is number) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
        (!('exercises' in data) || (data.exercises is list && data.exercises.size() <= 100)) &&
        (!('musclesTrained' in data) || (data.musclesTrained is list && data.musclesTrained.size() <= 50)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidTemplate(data) {
      return data.keys().hasAll(['id', 'userId', 'name']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('splitType' in data) || (data.splitType is string && data.splitType.size() <= 64)) &&
        (!('exercises' in data) || (data.exercises is list && data.exercises.size() <= 50)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidRecord(data) {
      return data.keys().hasAll(['id', 'userId', 'exerciseId', 'weightKg', 'reps', 'estimated1RM']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.exerciseId is string && data.exerciseId.size() <= 128 &&
        data.weightKg is number && data.weightKg >= 0 &&
        data.reps is number && data.reps >= 0 &&
        data.estimated1RM is number && data.estimated1RM >= 0 &&
        (!('exerciseName' in data) || (data.exerciseName is string && data.exerciseName.size() <= 128)) &&
        (!('workoutId' in data) || (data.workoutId is string && data.workoutId.size() <= 128)) &&
        (!('achievedAt' in data) || (data.achievedAt is string && data.achievedAt.size() <= 64)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // --- Health / Connection Test Probe ---
    match /test/{testId} {
      allow read: if true;
      allow write: if isSignedIn() || isValidId(testId);
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().id == userId;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().id == existing().id;
      allow delete: if isOwner(userId);

      // Workouts Subcollection
      match /workouts/{workoutId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(workoutId) && isValidWorkout(incoming()) && incoming().userId == userId && incoming().id == workoutId;
        allow update: if isOwner(userId) && isValidId(workoutId) && isValidWorkout(incoming()) && incoming().userId == existing().userId && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(workoutId);
      }

      // Templates Subcollection
      match /templates/{templateId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(templateId) && isValidTemplate(incoming()) && incoming().userId == userId && incoming().id == templateId;
        allow update: if isOwner(userId) && isValidId(templateId) && isValidTemplate(incoming()) && incoming().userId == existing().userId && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(templateId);
      }

      // Personal Records Subcollection
      match /personalRecords/{recordId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(recordId) && isValidRecord(incoming()) && incoming().userId == userId && incoming().id == recordId;
        allow update: if isOwner(userId) && isValidId(recordId) && isValidRecord(incoming()) && incoming().userId == existing().userId && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(recordId);
      }
    }
  }
}
